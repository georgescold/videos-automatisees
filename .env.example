# --- ElevenLabs (facultatif) ------------------------------------------------
# Les CLES ne se mettent plus ici : elles vivent dans le trousseau, bouton
# « Cles » en haut de l'interface (fichier .keys.json, non versionne). Plusieurs
# comptes gratuits = plusieurs quotas de 10 000 credits, et l'usine tourne
# entre eux toute seule apres avoir verifie qu'il y a de quoi faire la video.
# Une cle laissee ci-dessous est reprise dans le trousseau au demarrage.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voix par defaut. En palier GRATUIT, seules les voix « premade » d'ElevenLabs
# passent par l'API : les voix de bibliotheque (dont les voix francaises)
# renvoient une erreur 402. Sarah = EXAVITQu4vr4xnSDxMaL est une premade posee.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# La voix off part en eleven_v3 : seul modele qui obeit aux balises d'emotion
# posees beat par beat. 0 = tres expressif, 0.5 = naturel, 1 = sourd aux balises.
ELEVENLABS_V3_STABILITY=0.5
# Modele speech-to-speech (voice changer)
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2

# --- Voix off locale (sans cle) ---------------------------------------------
# Voix GENEREE en local, sans cle. Deux moteurs :
#  - Piper  : leger, francais, licence CC-BY (commercial OK).
#  - XTTS-v2: meilleure qualite, GPU, peut cloner ta voix. Licence NON
#             commerciale (CPML). Installation separee (voir README).
PIPER_VOICE=siwis-f
XTTS_VOICE=daisy-f
# Calage des sous-titres. base = rapide, small = plus precis. Le modele se
# telecharge tout seul au premier usage.
WHISPER_MODEL=base

# --- Pexels (photos et videos) ----------------------------------------------
# https://www.pexels.com/api/new/
PEXELS_API_KEY=

# --- Jamendo (musique de fond) ----------------------------------------------
# L'API Pexels ne propose aucun endpoint audio : la musique vient de Jamendo.
# Compte developpeur gratuit : https://devportal.jamendo.com
# Sans cette cle, seules les musiques deposees dans public/music sont utilisees.
JAMENDO_CLIENT_ID=
